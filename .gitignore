# ========================================================
# CoconutRisk AI - Component 03 Monorepo .gitignore
# ========================================================

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Node.js Dependencies & Artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Build Output
frontend/dist/
frontend/dist-ssr/
frontend/build/
*.local

# Python & ML Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.nyc_output/

# Dynamic Output Dirs & Generated Reports
generated_reports/
*.tmp
test_report.*
direct_test.*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Docker / Temporary Files
.docker/
docker-compose.override.yml

# Important: Preserve saved ML model checkpoints and research data
!ml-service/saved_models/
!ml-service/saved_models/*
!research-data/
!research-data/*
!.env.example
